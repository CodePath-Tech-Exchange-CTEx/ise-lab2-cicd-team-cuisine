# Local environment variables for Team Cuisine
# Copy this file to .env and fill in your own values.

# GCP project used by the app for BigQuery queries
GCP_PROJECT=

# Deployment/project metadata used by setup.sh and manual-deploy.sh
PROJECT_ID=
PROJECT_NUMBER=
SERVICE_NAME=
GITHUB_ORG=
GITHUB_REPO=

# Optional: set this locally if you want the app to use the same dataset name
# (code currently hardcodes `ISE` and uses GCP_PROJECT if set).
#GCP_DATASET=ISE
